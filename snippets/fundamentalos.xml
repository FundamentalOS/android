<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
    FundamentalOS overrides: only <remote>/<project> additions. Included from
    default.xml AFTER snippets/lineage.xml and snippets/remove.xml, so the forks
    below re-add (on the fundamentalos remote) the AOSP/LineageOS projects that
    remove.xml has already dropped. All <remove-project> entries live in
    snippets/remove.xml; lineage.xml itself is left untouched.
  -->
  <!-- These remotes carry revision="16": every FundamentalOS fork tracks the
       16 branch by default, so the projects below omit a per-project revision
       (repo resolves project.revision -> remote.revision -> default.revision).
       Scoped to these remotes only; the manifest-wide <default> in default.xml
       stays lineage-23.2 for the untouched LineageOS (github) projects. -->
  <remote name="fundamentalos" fetch="https://github.com/FundamentalOS/" revision="16" />
  <remote name="fundaagent" fetch="git@github.com:FundaAgent/" revision="16" />

  <!-- libz built from zlib-ng (compat); +~30-53% inflate on arm64 -->
  <project path="external/zlib" name="android_external_zlib" remote="fundamentalos" groups="pdk" />
  <project path="external/zlib-ng" name="android_external_zlib-ng" remote="fundamentalos" />

  <!-- ABI reference dumps regenerated for the zlib-ng libz -->
  <project path="prebuilts/abi-dumps/platform" name="android_prebuilts_abi-dumps_platform" remote="fundamentalos" groups="pdk-cw-fs,pdk-fs" clone-depth="1" />

  <!-- allowed_deps: libz_ng_headers -->
  <project path="packages/modules/common" name="android_packages_modules_common" remote="fundamentalos" groups="pdk-cw-fs,pdk-fs" />

  <!-- ConnectivityService: install the firewall UID allowlist when a network connects
       (LineageOS transport firewall left never-validating networks unreachable for apps) -->
  <project path="packages/modules/Connectivity" name="android_packages_modules_Connectivity" remote="fundamentalos" groups="pdk-cw-fs,pdk-fs" />

  <!-- lock screen clock font (google-sans-flex-clock) -->
  <project path="packages/overlays/Lineage" name="android_packages_overlays_Lineage" remote="fundamentalos" />

  <!--
    mimalloc as a selectable bionic allocator, gated on MALLOC_USE_MIMALLOC.
    Default stays Scudo (MTE); build with MALLOC_USE_MIMALLOC=true to opt in.
      - external/mimalloc : vendored mimalloc v2.5.0 + Android.bp + purge tuning + heap zero-init
      - bionic            : mimalloc allocator wrapper (malloc_use_mimalloc)
      - build/soong       : Malloc_use_mimalloc product variable
      - build/make        : MALLOC_USE_MIMALLOC -> Malloc_use_mimalloc bridge
  -->
  <project path="bionic" name="android_bionic" remote="fundamentalos" groups="pdk" />
  <project path="build/soong" name="android_build_soong" remote="fundamentalos" groups="pdk,tradefed,sysui-studio" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>
  <project path="build/make" name="android_build" remote="fundamentalos" groups="pdk,sysui-studio" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <project path="external/mimalloc" name="android_external_mimalloc" remote="fundamentalos" />

  <!-- libmeminfo: attribute [anon:mimalloc] heap to Native Heap in
       Debug.getMemoryInfo() (dumpsys meminfo / procstats / Settings);
       otherwise mimalloc arenas land in Unknown -> inflated "Android OS" -->
  <project path="system/memory/libmeminfo" name="android_system_memory_libmeminfo" remote="fundamentalos" groups="pdk" />

  <!-- private release signing keys (repo is private; sync needs the SSH key) -->
  <!-- FundamentalOS vendor namespace at vendor/fundamental: common/ (branded fork of LineageOS vendor) -->
  <project path="vendor/fundamental/common" name="android_vendor_fundamental_common" remote="fundamentalos" />
  <!-- native perf benchmark harness (zlib-ng / mimalloc / simdutf); fundamental_perf_bench + runner. See vendor/fundamental/bench/README.md -->
  <project path="vendor/fundamental/bench" name="android_vendor_fundamental_bench" remote="fundamentalos" />
  <!-- FundamentalOS apps (AOSP packages/apps layout) -->
  <project path="packages/apps/SystemUIFundamental" name="android_packages_apps_SystemUIFundamental" remote="fundamentalos" />
  <project path="packages/apps/ColumbusService" name="android_packages_apps_ColumbusService" remote="fundamentalos" />

  <!-- lineage-sdk: user-visible OS-name strings rebranded to FundamentalOS -->
  <project path="lineage-sdk" name="android_lineage-sdk" remote="fundamentalos" />

  <!-- Settings: version-preference dedup + FundamentalOS branding -->
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" remote="fundamentalos" groups="pdk-fs,pdk-cw-tvc,sysui-studio" />

  <!-- Trebuchet: default 4x5 grid (config_default_grid_name) + minimal FundamentalOS workspace -->
  <project path="packages/apps/Launcher3" name="android_packages_apps_Launcher3" remote="fundamentalos" groups="pdk-fs,sysui-studio,pdk-cw-tvc" />

  <!-- ThemePicker: preview icon shape/theme with the Settings icon instead of Camera2 -->
  <project path="packages/apps/ThemePicker" name="android_packages_apps_ThemePicker" remote="fundamentalos" groups="pdk-fs,sysui-studio" />
  <project path="packages/apps/LineageParts" name="android_packages_apps_LineageParts" remote="fundamentalos" />

  <!-- MindTheGapps (minimal GMS), tracked in-org -->
  <project path="vendor/gapps" name="android_vendor_gapps" remote="fundamentalos" />

  <!-- Google Chrome (Trichrome), replaces Jelly -->
  <project path="vendor/gapps/chrome" name="android_vendor_gapps_chrome" remote="fundamentalos" />

  <!-- Pixel lockscreen clock plugins (SystemUIClocks-*): presigned prebuilts from stock
       BP4A. Inherited ROM-wide via vendor/fundamental; loaded on user builds through
       config_pluginAllowlist (vendor/fundamental/overlay/common) -->
  <project path="packages/apps/SystemUIClocks" name="android_packages_apps_SystemUIClocks" remote="fundamentalos" />


  <project path="vendor/lineage-priv" name="vendor_lineage-priv" remote="fundaagent" />

  <!-- CJK: notocjk-enhanced Noto CJK VF (chws + full wght 100-900 + emoji cmap) + USE_TYPO_METRICS -->
  <project path="external/noto-fonts" name="android_external_noto-fonts" remote="fundamentalos" revision="16" groups="pdk" />

  <!-- frameworks/base: fonts.xml CJK weight rewire (+ future framework customizations) -->
  <project path="frameworks/base" name="android_frameworks_base" remote="fundamentalos" revision="16" groups="pdk-cw-fs,pdk-fs,sysui-studio" />

  <!-- frameworks/opt/telephony: keep PS attach allowed on both SIM slots (Shannon RIL DSDS fix, PhoneSwitcher) -->
  <project path="frameworks/opt/telephony" name="android_frameworks_opt_telephony" remote="fundamentalos" revision="16" groups="pdk,sysui-studio" />

  <!-- perf/power audit forks: native / av / system_core / art (see fwb-perf-power-audit) -->
  <project path="frameworks/native" name="android_frameworks_native" remote="fundamentalos" revision="16" groups="pdk" />
  <project path="frameworks/av" name="android_frameworks_av" remote="fundamentalos" revision="16" groups="pdk,sysui-studio" />
  <project path="system/core" name="android_system_core" remote="fundamentalos" revision="16" groups="pdk" />
  <project path="art" name="android_art" remote="fundamentalos" revision="16" groups="pdk" />

  <!-- keystore2: per-app keybox attestation for selective Play Integrity DEVICE (plan B) -->
  <project path="system/security" name="android_system_security" remote="fundamentalos" groups="pdk" />
</manifest>
