<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
    FundamentalOS repositories: only <remote>/<project> additions; all
    <remove-project> entries live in snippets/remove.xml. Both remotes carry
    revision="17", so projects omit a per-project revision. Everything here is
    tracked in the FundamentalOS org: LineageOS-derived repositories are
    imported, not referenced. Device trees, kernels, GCam and the proprietary
    vendor blobs are NOT listed; roomservice fetches them through the
    fundamental.dependencies chain (device/google/caiman -> caimito ->
    zumapro, caimito-kernels, gcam, vendor/google/caiman).
  -->
  <remote name="fundamentalos" fetch="https://github.com/FundamentalOS/" revision="17" />
  <remote name="fundaagent" fetch="git@github.com:FundaAgent/" revision="17" />

  <!-- Build system: AOSP android-17.0.0_r1 + LineageOS 24 build support + FundamentalOS hooks
       (mimalloc bridge, Tensor G4 cpu variants, Play Integrity sysprop overrides) -->
  <project path="build/make" name="android_build" remote="fundamentalos" groups="pdk,sysui-studio" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <project path="build/soong" name="android_build_soong" remote="fundamentalos" groups="pdk,tradefed,sysui-studio" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <!-- Native platform forks: AOSP android-17.0.0_r1 + FundamentalOS commits
       (mimalloc allocator, simdutf UTF transcoding, Tensor G4 cpu variants,
       SurfaceFlinger/audio/camera micro-optimizations, zlib-ng libz, CJK fonts) -->
  <project path="bionic" name="android_bionic" remote="fundamentalos" groups="pdk" />
  <project path="system/core" name="android_system_core" remote="fundamentalos" groups="pdk" />
  <project path="frameworks/av" name="android_frameworks_av" remote="fundamentalos" groups="pdk,sysui-studio" />
  <project path="frameworks/native" name="android_frameworks_native" remote="fundamentalos" groups="pdk" />
  <project path="art" name="android_art" remote="fundamentalos" groups="pdk" />
  <project path="external/zlib" name="android_external_zlib" remote="fundamentalos" groups="pdk" />
  <project path="external/zlib-ng" name="android_external_zlib-ng" remote="fundamentalos" />
  <project path="external/mimalloc" name="android_external_mimalloc" remote="fundamentalos" />
  <project path="external/simdutf" name="android_external_simdutf" remote="fundamentalos" />
  <project path="external/noto-fonts" name="android_external_noto-fonts" remote="fundamentalos" groups="pdk" />
  <project path="system/memory/libmeminfo" name="android_system_memory_libmeminfo" remote="fundamentalos" groups="pdk" />

  <!-- Pixel HAL / sepolicy that left AOSP with Android 16 (LineageOS lineage-24.0 imports) -->
  <project path="hardware/google/pixel" name="android_hardware_google_pixel" remote="fundamentalos" />
  <project path="hardware/google/pixel-sepolicy" name="android_hardware_google_pixel-sepolicy" remote="fundamentalos" />

  <!-- Common sepolicy (fork of LineageOS device/lineage/sepolicy) -->
  <project path="device/fundamental/sepolicy" name="android_device_fundamental_sepolicy" remote="fundamentalos" />

  <!-- LineageOS-derived extras kept by FundamentalOS -->
  <project path="external/google-fonts/google-sans-flex" name="android_external_google-fonts_google-sans-flex" remote="fundamentalos" />
  <project path="packages/resources/devicesettings" name="android_packages_resources_devicesettings" remote="fundamentalos" />
  <project path="external/bash" name="android_external_bash" remote="fundamentalos" />
  <project path="external/htop" name="android_external_htop" remote="fundamentalos" />
  <project path="external/nano" name="android_external_nano" remote="fundamentalos" />
  <project path="external/vim" name="android_external_vim" remote="fundamentalos" />
  <project path="external/openssh" name="android_external_openssh" remote="fundamentalos" />
  <project path="external/json-c" name="android_external_json-c" remote="fundamentalos" />
  <project path="external/libncurses" name="android_external_libncurses" remote="fundamentalos" />

  <!-- Blob / kernel extraction tooling (LineageOS imports) -->
  <project path="tools/extract-utils" name="android_tools_extract-utils" remote="fundamentalos" />
  <project path="prebuilts/extract-tools" name="android_prebuilts_extract-tools" remote="fundamentalos" clone-depth="1" />

  <!-- APN database (LineageOS import) -->
  <project path="vendor/apn" name="android_vendor_apn" remote="fundamentalos" />

  <!-- DeviceConfig flag seeding at boot (configs_base / configs_device / configs_product) -->
  <project path="packages/apps/SimpleDeviceConfig" name="android_packages_apps_SimpleDeviceConfig" remote="fundamentalos" />

  <!-- vendor -->
  <project path="vendor/fundamental/common" name="android_vendor_fundamental_common" remote="fundamentalos" />
  <project path="vendor/fundamental/bench" name="android_vendor_fundamental_bench" remote="fundamentalos" />
  <project path="vendor/gapps" name="android_vendor_gapps" remote="fundamentalos" />
  <project path="vendor/gapps/chrome" name="android_vendor_gapps_chrome" remote="fundamentalos" />
  <!-- private release signing keys (repo is private; sync needs the SSH key) -->
  <project path="vendor/lineage-priv" name="vendor_lineage-priv" remote="fundaagent" />

  <!-- FundamentalOS apps -->
  <project path="packages/apps/SystemUIFundamental" name="android_packages_apps_SystemUIFundamental" remote="fundamentalos" />
  <project path="packages/apps/SystemUIClocks" name="android_packages_apps_SystemUIClocks" remote="fundamentalos" />
  <project path="packages/apps/ColumbusService" name="android_packages_apps_ColumbusService" remote="fundamentalos" />
  <project path="packages/apps/FundamentalForge" name="android_packages_apps_FundamentalForge" remote="fundamentalos" />
  <project path="packages/apps/ExactCalculator" name="android_packages_apps_ExactCalculator" remote="fundamentalos" />
</manifest>
