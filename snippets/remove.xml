<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
    FundamentalOS project removals: every AOSP project replaced by a
    FundamentalOS fork is dropped here before snippets/fundamentalos.xml
    re-adds it on the fundamentalos remote. Included from default.xml
    BEFORE snippets/fundamentalos.xml. Empty until the platform forks are
    rebased onto android-17.0.0_r1.
  -->
  <remove-project name="platform/build" />
  <remove-project name="platform/build/soong" />
  <remove-project name="platform/bionic" />
  <remove-project name="platform/system/core" />
  <remove-project name="platform/frameworks/av" />
  <remove-project name="platform/frameworks/native" />
  <remove-project name="platform/art" />
  <remove-project name="platform/external/zlib" />
  <remove-project name="platform/external/noto-fonts" />
  <remove-project name="platform/system/memory/libmeminfo" />
  <remove-project name="platform/frameworks/base" />
  <remove-project name="platform/frameworks/opt/telephony" />
  <remove-project name="platform/packages/apps/Settings" />
  <remove-project name="platform/packages/apps/Launcher3" />
  <remove-project name="platform/packages/apps/ThemePicker" />
  <remove-project name="platform/system/security" />
  <remove-project name="platform/external/rust/crates/openssl" />
  <remove-project name="platform/external/rust/android-crates-io" />
  <remove-project name="platform/system/sepolicy" />
</manifest>
